{
  "name": "obsidian-enhancing-export",
  "version": "1.12.0",
  "description": "This is a enhancing export plugin for Obsidian. It allows to export to formats like Html, DOCX, ePub and PDF or Markdown(Hugo) etc.",
  "main": "main.js",
  "scripts": {
    "dev": "vite build -w -m development",
    "build": "vite build",
    "version-bump": "node version.mjs bump",
    "version": "node version.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint-fix": "eslint --fix .",
    "format-check": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\"",
    "format-fix": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\"",
    "test": "jest"
  },
  "keywords": [],
  "author": "YISH",
  "license": "MIT",
  "repository": "https://github.com/mokeyish/obsidian-enhancing-export",
  "type": "module",
  "//overrides": "babel-plugin-istanbul <8 drags in the deprecated glob@7/inflight chain. The pnpm equivalent lives in pnpm-workspace.yaml.",
  "overrides": {
    "babel-plugin-istanbul": "^8.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/semver": "^7.8.0",
    "@types/yargs-parser": "^21.0.3",
    "eslint": "^10.8.0",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "globals": "^17.9.0",
    "jest": "^30.4.2",
    "obsidian": "^1.13.1",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vite-plugin-solid": "^2.11.14",
    "vite-plugin-static-copy": "^4.1.1"
  },
  "dependencies": {
    "semver": "^7.8.5",
    "solid-js": "^1.9.14",
    "yargs-parser": "^22.0.0"
  }
}
