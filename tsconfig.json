{
  "compilerOptions": {
    "rootDir": ".",
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES2021",
    "allowJs": true,
    // TypeScript 6 turns `strict` on by default; the codebase has never been
    // strict-clean, so keep the previous behaviour explicit.
    "strict": false,
    "noImplicitAny": true,
    // Without this, `bind`/`call`/`apply` return `any` and leak it into whatever
    // they are assigned to — the only reason `saveSettings` needed annotating.
    "strictBindCallApply": true,
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    // The lua-filter catalogue is JSON, and its test reads it directly.
    "resolveJsonModule": true,
    "importHelpers": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "noEmit": true,
    "isolatedModules": true,
    // Only declaration files are skipped, never our own source. Three things
    // need it, none of them ours to fix: obsidian's typings contradict
    // themselves under TS 6 (`onHistoryBack`), augmenting `DataAdapter` in
    // typings/obsidian.d.ts leaves its own classes short of the members we
    // added, and electron and @types/node declare `noDeprecation` with
    // different modifiers.
    "skipLibCheck": true,
    "lib": [
      "DOM",
      "ES5",
      "ES6",
      "ES7",
      "ES2021"
    ],
    "typeRoots": [ "./typings", "./node_modules/@types"],
    // TypeScript 6 no longer pulls in every @types package automatically.
    "types": [ "jest", "node"]
  },
  "include": [
    "**/*.ts",  "**/*.tsx"
  ]
}