{
  "compilerOptions": {
    "rootDir": ".",
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES2021",
    "allowJs": true,
    // TypeScript 6 turns `strict` on by default; the codebase has never been
    // strict-clean, so keep the previous behaviour explicit.
    "strict": false,
    "noImplicitAny": true,
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "importHelpers": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "noEmit": true,
    "isolatedModules": true,
    "lib": [
      "DOM",
      "ES5",
      "ES6",
      "ES7",
      "ES2021"
    ],
    "typeRoots": [ "./typings", "./node_modules/@types"],
    // TypeScript 6 no longer pulls in every @types package automatically.
    "types": [ "jest", "node"]
  },
  "include": [
    "**/*.ts",  "**/*.tsx"
  ]
}